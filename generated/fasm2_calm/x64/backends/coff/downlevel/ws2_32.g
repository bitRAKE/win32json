	if used WSCUnInstallNameSpace
		extrn WSCUnInstallNameSpace
	end if
	if used WSCUnInstallNameSpace32
		extrn WSCUnInstallNameSpace32
	end if
	if used WSCUpdateProvider
		extrn WSCUpdateProvider
	end if
	if used WSCUpdateProvider32
		extrn WSCUpdateProvider32
	end if
	if used WSCWriteNameSpaceOrder
		extrn WSCWriteNameSpaceOrder
	end if
	if used WSCWriteNameSpaceOrder32
		extrn WSCWriteNameSpaceOrder32
	end if
	if used WSCWriteProviderOrder
		extrn WSCWriteProviderOrder
	end if
	if used WSCWriteProviderOrder32
		extrn WSCWriteProviderOrder32
	end if
end postpone
