		extrn MFUnlockWorkQueue
	end if
	if used MFUnregisterPlatformFromMMCSS
		extrn MFUnregisterPlatformFromMMCSS
	end if
	if used MFUnwrapMediaType
		extrn MFUnwrapMediaType
	end if
	if used MFValidateMediaTypeSize
		extrn MFValidateMediaTypeSize
	end if
	if used MFWrapMediaType
		extrn MFWrapMediaType
	end if
end postpone
