; UnregisterInterfaceTimestampConfigChange -> win32.api.iphlpapi.UnregisterInterfaceTimestampConfigChange
calminstruction UnregisterInterfaceTimestampConfigChange \
	NotificationHandle*
	call win32.api.iphlpapi.UnregisterInterfaceTimestampConfigChange,NotificationHandle
end calminstruction

