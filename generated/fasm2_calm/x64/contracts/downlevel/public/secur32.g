	call win32.api.secur32.SspiValidateAuthIdentity,AuthData
end calminstruction

; SspiZeroAuthIdentity -> win32.api.secur32.SspiZeroAuthIdentity
calminstruction SspiZeroAuthIdentity \
	AuthData:0
	call win32.api.secur32.SspiZeroAuthIdentity,AuthData
end calminstruction

; TranslateNameA -> win32.api.secur32.TranslateNameA
calminstruction TranslateNameA \
	lpAccountName*,AccountNameFormat*,DesiredNameFormat*,\
	lpTranslatedName:0,nSize*
	call win32.api.secur32.TranslateNameA,lpAccountName,AccountNameFormat,DesiredNameFormat,lpTranslatedName,nSize
end calminstruction

; TranslateNameW -> win32.api.secur32.TranslateNameW
calminstruction TranslateNameW \
	lpAccountName*,AccountNameFormat*,DesiredNameFormat*,\
	lpTranslatedName:0,nSize*
	call win32.api.secur32.TranslateNameW,lpAccountName,AccountNameFormat,DesiredNameFormat,lpTranslatedName,nSize
end calminstruction

; VerifySignature -> win32.api.secur32.VerifySignature
calminstruction VerifySignature \
	phContext*,pMessage*,MessageSeqNo*,\
	pfQOP*
	call win32.api.secur32.VerifySignature,phContext,pMessage,MessageSeqNo,pfQOP
end calminstruction

